  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "jest -c ../../jest.config.js --rootDir ../.. --testPathPatterns packages/capkit"
  },
  "keywords": [
    "capability-token",
    "execution-trace",
