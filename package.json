{
  "name": "absuite-core",
  "version": "1.0.0",
  "description": "ABSuite \u2014 Agent Builder Suite. Complete infrastructure for building, deploying, and scaling production AI agents.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "start": "docker compose -f docker-compose.yml up -d",
    "stop": "docker compose -f docker-compose.yml down",
    "restart": "docker compose -f docker-compose.yml restart",
    "test": "jest",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "cli": "pnpm --filter @absuitecore/cli run dev",
    "cli:build": "pnpm --filter @absuitecore/cli build",
    "publish:packages": "pnpm -r --filter \"@absuitecore/*\" build && pnpm -r --filter \"@absuitecore/*\" publish --access public --no-git-checks",
    "publish:dry": "pnpm -r --filter \"@absuitecore/*\" exec npm pack --dry-run",
    "backup": "node scripts/backup.mjs create",
    "backup:verify": "node scripts/backup.mjs verify",
    "backup:restore": "node scripts/backup.mjs restore",
    "docs:api": "node scripts/gen-api-docs.mjs",
    "docs:check": "node scripts/gen-api-docs.mjs --check",
    "test:coverage": "jest --coverage --coverageReporters=lcov --coverageReporters=text-summary",
    "test:packages": "pnpm -r test",
    "check:routes": "node scripts/check-dashboard-routes.mjs",
    "check:constraints": "node scripts/check-constraints.mjs",
    "check:doctrine": "node scripts/check-doctrine.mjs",
    "verify": "pnpm build && pnpm test && pnpm docs:check && pnpm check:routes && pnpm check:constraints && pnpm check:doctrine",
    "check:live": "node scripts/check-live-routes.mjs",
    "bench:core": "pnpm --filter @absuitecore/quickbench build && node packages/quickbench/dist/bench-cli.js",
    "bench:doc": "node scripts/gen-performance-doc.mjs"
  },
  "bin": {
    "absuite": "./packages/cli/dist/index.js"
  },
  "keywords": [
    "absuite",
    "ai-agents",
    "agent-builder",
    "infrastructure",
    "llm",
    "orchestration",
    "security",
    "benchmarks"
  ],
  "author": "ABSuite Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@types/socket.io": "^3.0.2",
    "socket.io": "^4.8.0"
  },
  "engines": {
    "node": ">=22.5.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
