# ABSuite Production Environment Template
# ================================================
# Copy this to .env and generate REAL 64-char random values for production
# Use: openssl rand -hex 32 (Linux/Mac) or pwsh: [Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# ================================================

# Core Security (REQUIRED for GA)
CAPKIT_HMAC_SECRET=your_capkit_hmac_secret_here_64_chars_min_$(openssl_rand_hex_32)
CAPKIT_JWT_SECRET=your_capkit_jwt_secret_here_64_chars_min_$(openssl_rand_hex_32)
ABSUITE_ADMIN_API_KEY=your_admin_api_key_here_64_chars_min_$(openssl_rand_hex_32)

# Bootstrap key CapKit accepts for issuing the first capability token, and the
# credential the dashboard presents to CapKit. Defaults to ABSUITE_ADMIN_API_KEY
# when unset; set separately to rotate the two independently.
CAPKIT_ADMIN_KEY=

# Optional: enforce an audience claim on every capability token
# CAPKIT_AUDIENCE=absuite://production

# Where CapKit mirrors its audit trail (JSONL, survives restart)
CAPKIT_AUDIT_LOG=/data/capkit-audit.jsonl

# Shared revocation store. Every service reads this, so revoking a token at
# CapKit locks it out of Edge-Run, QuickBench and Connector-Starter too.
# Superseded by ABSUITE_DB_PATH when that is set (SQLite is preferred).
CAPKIT_REVOCATION_FILE=/data/capkit-revocations.jsonl

# Shared SQLite database. Enables durable revocation, tenancy, metering and
# verifiable execution traces across every service.
ABSUITE_DB_PATH=/data/absuite.db

# ---- Verifiable execution ----
# Ed25519 private key (PKCS8 PEM) used to sign execution traces. Asymmetric on
# purpose: an auditor verifies with the public half and can never forge.
# Generate with:
#   node -e "const{SigningKey}=require('@absuitecore/capkit');console.log(SigningKey.generate().privateKeyPem)"
# If unset a key is generated at boot and prior signatures stop verifying.
CAPKIT_TRACE_PRIVATE_KEY=
CAPKIT_TRACE_KEY_ID=absuite-trace-key

# ---- Self-serve signup ----
# Public signup mints real credentials, so it is OFF unless explicitly enabled.
ABSUITE_SIGNUP_ENABLED=false
ABSUITE_SIGNUP_PLAN=free

# ---- Billing (optional) ----
# Without this the Stripe webhook rejects every call.
STRIPE_WEBHOOK_SECRET=

# ---- Edge-Run ----
EDGERUN_MAX_CONCURRENT=10
EDGERUN_QUEUE_LIMIT=100
# Script execution is an RCE vector, so it is OFF unless you set a root
# directory. Only scripts resolving inside it will run.
EDGERUN_SCRIPT_ROOT=
# Comma-separated hosts an http task may call. Empty allows any host.
EDGERUN_ALLOWED_HOSTS=
EDGERUN_FAILURE_THRESHOLD=5
EDGERUN_COOLDOWN_MS=30000

# ---- Connector-Starter (all optional) ----
# GITHUB_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# NOTION_TOKEN=
# LINEAR_API_KEY=

# ── The database is NOT encrypted at rest ────────────────────────────────────
#
# There was an ABSUITE_DB_ENCRYPTION_KEY here, telling you to generate 32 random
# bytes. Nothing read it. Not the code, not docker-compose, not the Kubernetes
# manifests — it existed only in this file, so an operator who set it believed
# their database was encrypted and it never was.
#
# That is the exact failure this project exists to argue against, committed in
# its own configuration, in a security product. It is removed rather than
# quietly implemented, because the honest statement matters more than the
# feature: the SQLite file at ABSUITE_DB_PATH is plaintext. Protect it with disk
# encryption and file permissions, and treat a stolen disk as a stolen record.
#
# Payloads are hashed and dropped, so the file holds hashes, subjects, scopes and
# timestamps — not your inputs and outputs. That is a real mitigation and it is
# not encryption.

# Origins (Update for your domain)
ABSUITE_ALLOWED_ORIGINS=http://localhost:3001,https://yourdomain.com

# There is deliberately no ABSUITE_LOG_LEVEL. It used to be passed to all six
# containers and read by nothing. The reason it was removed rather than
# implemented is worth stating: the services log startup lines and warnings, and
# the warnings are the ones that say your signing key is ephemeral, no admin key
# is set, or the notary will invalidate every receipt it has issued when it
# restarts. There is no debug tier for a level to unlock — there is only a
# setting that would let an operator turn those off. A product whose argument is
# that it opens by naming its own faults does not ship the switch that hides
# them. See docs/AUDIT.md §3c.

# ── Optional, and read ───────────────────────────────────────────────────────
# Everything below is genuinely consumed by the code. Defaults in parentheses.

# ABSUITE_PUBLIC_PASSWORD=            # gates a public instance. Set it before exposing one.
# ABSUITE_BIND=127.0.0.1              # interface to bind. Loopback by default, deliberately.
# ABSUITE_RATE_LIMIT_PER_MINUTE=60    # per-IP burst limit
# ABSUITE_WATCH_INTERVAL_MS=60000     # how often Layer 6 sweeps the record
# ABSUITE_TRUST_SCORE_HUMANS=         # leave unset. Scoring people is a constitutional refusal.

# The notary signs with its own key, and must — a notary that shared the
# operator's key would be a second signature from the same party.
# CAPKIT_NOTARY_PRIVATE_KEY=
# NOTARY_KEY_ID=absuite-notary
# NOTARY_PORT=8086

# Ports and inter-service URLs. Sensible defaults; override only if you move one.
# CAPKIT_PORT=8081       CAPKIT_URL=http://localhost:8081
# EDGERUN_PORT=8082      EDGE_RUN_URL=http://localhost:8082
# QUICKBENCH_PORT=8083   QUICKBENCH_URL=http://localhost:8083
# CONNECTOR_STARTER_PORT=8084
# TRUST_PORT=8085        TRUST_URL=http://localhost:8085
# DASHBOARD_URL=http://localhost:3001

# Optional AI Providers
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# QUICKBENCH_OLLAMA_URL=http://host.docker.internal:11434

# ================================================
# SECURITY NOTES:
# 1. Never commit .env with real values
# 2. Rotate secrets every 90 days
# 3. Use Docker secrets or Vault in prod
# 4. Minimum 256-bit (64 hex chars) entropy
# ================================================

