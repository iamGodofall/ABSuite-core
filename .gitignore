# Dependencies
node_modules/
.pnp/
.pnp.js

# pnpm-lock.yaml is deliberately NOT ignored. CI installs with
# --frozen-lockfile, and a project whose whole argument is "verify what you
# installed" cannot resolve its own dependencies differently on every machine.
# It survived here only because it was committed before this rule existed.

# Production builds
dist/
build/
out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
data/
*.db

# Coverage
coverage/

# TypeScript
*.tsbuildinfo
.DS_Store
Thumbs.db

# IDE/Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# OS generated
.DS_Store
desktop.ini

# Testing
.nyc_output

# Generated
*.tgz

# Python scratch — no Python in this project, but tooling leaves it behind
__pycache__/
*.pyc


# Benchmark history is local; the published measurement is bench/core-latest.json
bench/history/

# Single-file build for sharing the room without a backend.
packages/dashboard-ui/dist-artifact/

# Private key material, whatever writes it. A trace signing key committed once is
# public for ever, and rotating it fails every record it already signed.
*trace-key*.json
*-key-pair.json
*.pem
!**/fixtures/**/*.pem
